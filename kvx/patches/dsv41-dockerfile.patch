diff --git a/Dockerfile b/Dockerfile
index eba34a0112663a31f7dfdac67625cc54e3f6db62..2362bafafb582a153e3d7c0ca8d5ee21eeabbc72 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -30,6 +30,9 @@ WORKDIR /src
 COPY . .
 ARG CUDA_ARCHITECTURES="75;80;86;89;120"
 ARG BUILD_VISION=1
