+    def test_an_answer_out_of_step_ends_the_engine(self):
+        self.svc.kv_note("s1", [1])
+        orig = FakeProc.write
+        def bad(proc, s):
+            proc.sent.append(s.strip())
+            proc.engine.lines.put("SAVEDX 1 100 12.5 nothex!!nothex!! 0000000000000000\n")
+        FakeProc.write = bad
+        try:
+            code, _ = self.save()
+        finally:
