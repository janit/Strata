+    def test_session_save_reclaim_retries_a_save_by_session(self):
+        # --session-save-reclaim: an unpublished RAM refusal is tried again, with the same SAVEX line
+        from unittest import mock
+        self.svc.kv_note("s1", [1, 2])
+        tries = []
+
+        def during():
+            tries.append(1)
